# Copy to .env.local and fill in. Every variable is required except RATE_LIMIT_IP_WHITELIST.
# Never commit real values; .env.local is gitignored.

# Neon Postgres. Locally, use the Neon dev branch, never production.
DATABASE_URL=postgresql://user:password@your-endpoint.neon.tech/neondb?sslmode=require

# Gmail account and its app-specific password, used to send emails
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Site origin used for the reveal links in emails, without the /secret-santa basePath
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Cloudflare Turnstile site and secret keys (for npm run dev, see .env.development.local in the README)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# Secret key for hashing rate-limit buckets (HMAC), so stored hashes can't be reversed
# back to IP addresses. Any long random string, e.g. from: openssl rand -hex 32
RATE_LIMIT_HASH_SECRET=your-random-secret

# Optional: comma-separated IPs that are never rate limited
RATE_LIMIT_IP_WHITELIST=
